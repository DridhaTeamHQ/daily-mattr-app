# Copy to .env and fill in. .env is git-ignored.
# EXPO_PUBLIC_* vars are inlined into the client bundle by the Expo CLI.
# After editing .env, restart the dev server with: npx expo start -c

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server/tooling only. NEVER prefix this with EXPO_PUBLIC_ and never import it
# from src/ — it bypasses RLS and would ship inside the app bundle.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
